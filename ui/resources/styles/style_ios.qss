/* ============================================================
   PAX WALLET - iOS STYLE
   Ispirato a iOS, colori chiari e puliti
   ============================================================ */

/* ============================================================
   GENERALE
   ============================================================ */

QWidget {
    background-color: #f2f2f7;
    color: #1c1c1e;
    font-family: -apple-system, "SF Pro Display", "Helvetica Neue", sans-serif;
}

/* ============================================================
   SIDEBAR
   ============================================================ */

#sidebar {
    background-color: #ffffff;
    border-right: 1px solid #e5e5ea;
}

#logo {
    color: #007aff;
    font-size: 18px;
    font-weight: 600;
    padding: 10px 0;
}

#wallet_info {
    background-color: #f8f9fc;
    border: 1px solid #e5e5ea;
    border-radius: 12px;
    padding: 12px;
}

#wallet_name {
    color: #1c1c1e;
    font-size: 12px;
    font-weight: 500;
}

#balance {
    color: #007aff;
    font-size: 16px;
    font-weight: 600;
}

#nav_button {
    background-color: transparent;
    color: #8e8e93;
    border: none;
    padding: 10px 15px;
    text-align: left;
    font-size: 13px;
    border-radius: 10px;
    font-weight: 500;
}

#nav_button:hover {
    background-color: #f2f2f7;
    color: #007aff;
}

#nav_button:checked {
    background-color: #007aff;
    color: #ffffff;
    font-weight: 600;
}

#version {
    color: #8e8e93;
    font-size: 10px;
}

/* ============================================================
   CONTENUTO PRINCIPALE
   ============================================================ */

#content_stack {
    background-color: #f2f2f7;
}

.view_title {
    color: #1c1c1e;
    font-size: 24px;
    font-weight: 700;
}

#welcome_label {
    color: #8e8e93;
    font-size: 14px;
    padding: 8px 0;
    border-bottom: 1px solid #e5e5ea;
    margin-bottom: 10px;
}

/* ============================================================
   UNLOCK WINDOW
   ============================================================ */

#unlock_logo {
    color: #007aff;
    font-size: 36px;
    font-weight: 700;
}

#unlock_desc {
    color: #8e8e93;
    font-size: 14px;
}

#error {
    color: #ff3b30;
    font-size: 13px;
}

/* ============================================================
   BALANCE CARD
   ============================================================ */

#balance_card {
    background-color: #ffffff;
    border: 1px solid #e5e5ea;
    border-radius: 16px;
    padding: 30px;
}

#big_balance {
    color: #1c1c1e;
    font-size: 34px;
    font-weight: 700;
}

#usd_balance {
    color: #8e8e93;
    font-size: 16px;
}

/* ============================================================
   LISTE - STORICO, WALLET, RETICULUM OUTPUT
   ============================================================ */

#tx_list, #wallet_list, #output_list {
    background-color: #ffffff;
    border: 1px solid #e5e5ea;
    border-radius: 12px;
    color: #1c1c1e;
    padding: 5px;
    font-family: "SF Pro Display", -apple-system, sans-serif;
    font-size: 12px;
}

#tx_list::item, #wallet_list::item, #output_list::item {
    padding: 6px 12px;
    border-radius: 6px;
}

#tx_list::item:hover, #wallet_list::item:hover, #output_list::item:hover {
    background-color: #f2f2f7;
}

#tx_list::item:selected, #wallet_list::item:selected, #output_list::item:selected {
    background-color: #007aff;
    color: #ffffff;
}

/* ============================================================
   RUBRICA - FORZA FONT MONOSPACE PER ALLINEAMENTO
   ============================================================ */

#contact_list {
    background-color: #ffffff;
    border: 1px solid #e5e5ea;
    border-radius: 12px;
    color: #1c1c1e;
    padding: 5px;
    font-family: "Courier New", "Monaco", "Consolas", monospace;
    font-size: 11px;
}

#contact_list::item {
    padding: 6px 12px;
    border-radius: 6px;
}

#contact_list::item:hover {
    background-color: #f2f2f7;
}

#contact_list::item:selected {
    background-color: #007aff;
    color: #ffffff;
}

/* ============================================================
   DETAIL PANEL (per ListViewWithDetail)
   ============================================================ */

#detail_panel {
    background-color: #ffffff;
    border: 1px solid #e5e5ea;
    border-radius: 14px;
    padding: 8px;
}

#detail_title {
    color: #007aff;
    font-weight: 600;
    font-size: 12px;
    padding: 0px;
    margin: 0px;
}

#detail_text {
    background-color: #fafafc;
    color: #1c1c1e;
    border: 1px solid #e5e5ea;
    border-radius: 10px;
    padding: 8px;
    font-family: "SF Pro Display", -apple-system, sans-serif;
    font-size: 11px;
    min-height: 50px;
}

/* ============================================================
   BOTTONI
   ============================================================ */

QPushButton {
    background-color: #007aff;
    color: #ffffff;
    border: none;
    border-radius: 10px;
    padding: 10px 20px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #0066d9;
}

QPushButton:pressed {
    background-color: #0055b3;
}

QPushButton:disabled {
    background-color: #b3b3b3;
    color: #8e8e93;
}

#quick_action {
    background-color: #ffffff;
    color: #007aff;
    border: 1px solid #e5e5ea;
    border-radius: 12px;
    padding: 15px;
    font-size: 14px;
    font-weight: 500;
}

#quick_action:hover {
    background-color: #f2f2f7;
    border-color: #007aff;
}

#send_btn {
    background-color: #007aff;
    color: #ffffff;
    font-weight: 600;
    padding: 14px;
    border: none;
    border-radius: 12px;
    font-size: 16px;
}

#send_btn:hover {
    background-color: #0066d9;
}

#send_btn:disabled {
    background-color: #b3b3b3;
    color: #8e8e93;
}

#exit_btn {
    background-color: #ffffff;
    color: #ff3b30;
    border: 1px solid #ff3b30;
    border-radius: 10px;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: 500;
}

#exit_btn:hover {
    background-color: #ff3b30;
    color: #ffffff;
}

#exit_btn:pressed {
    background-color: #d32f2f;
    border-color: #d32f2f;
}

/* ============================================================
   BOTTONE INVIA RUBRICA (VERDE IOS)
   ============================================================ */

#send_btn_contact {
    background-color: #34c759;
    color: #ffffff;
    font-weight: 600;
    padding: 10px 20px;
    border: none;
    border-radius: 10px;
    font-size: 13px;
}

#send_btn_contact:hover {
    background-color: #2db84e;
}

#send_btn_contact:pressed {
    background-color: #26a843;
}

/* ============================================================
   INPUT
   ============================================================ */

QLineEdit {
    background-color: #ffffff;
    color: #1c1c1e;
    border: 1px solid #e5e5ea;
    border-radius: 10px;
    padding: 10px 14px;
    font-size: 14px;
}

QLineEdit:focus {
    border-color: #007aff;
    background-color: #ffffff;
}

QLineEdit::placeholder {
    color: #b3b3b3;
}

/* ============================================================
   COMBO BOX
   ============================================================ */

QComboBox {
    background-color: #ffffff;
    color: #1c1c1e;
    border: 1px solid #e5e5ea;
    border-radius: 10px;
    padding: 8px 14px;
    font-family: "SF Pro Display", -apple-system, sans-serif;
    font-size: 13px;
}

QComboBox:hover {
    border-color: #007aff;
}

QComboBox::drop-down {
    border: none;
    padding-right: 10px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 5px solid #8e8e93;
    margin-right: 5px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #1c1c1e;
    border: 1px solid #e5e5ea;
    border-radius: 10px;
    selection-background-color: #007aff;
    selection-color: #ffffff;
}

/* ============================================================
   GROUP BOX
   ============================================================ */

QGroupBox {
    border: 1px solid #e5e5ea;
    border-radius: 12px;
    margin-top: 10px;
    padding-top: 10px;
    font-weight: 600;
    color: #1c1c1e;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
    color: #007aff;
}

/* ============================================================
   LABEL
   ============================================================ */

QLabel {
    color: #1c1c1e;
    font-family: "SF Pro Display", -apple-system, sans-serif;
}

.section_title {
    color: #1c1c1e;
    font-size: 16px;
    font-weight: 600;
    margin-top: 10px;
}

#status {
    color: #1c1c1e;
    font-size: 13px;
}

#status_value {
    color: #1c1c1e;
    font-size: 13px;
    font-weight: 600;
}

#ip_label {
    color: #1c1c1e;
    font-size: 13px;
    font-weight: 600;
}

#tor_label {
    color: #1c1c1e;
    font-size: 13px;
    font-weight: 600;
}

#internet_label {
    color: #1c1c1e;
    font-size: 13px;
    font-weight: 600;
}

#network_info {
    color: #1c1c1e;
    font-size: 13px;
}

/* ============================================================
   SPIN BOX
   ============================================================ */

QSpinBox {
    background-color: #ffffff;
    color: #1c1c1e;
    border: 1px solid #e5e5ea;
    border-radius: 10px;
    padding: 5px 10px;
    font-family: "SF Pro Display", -apple-system, sans-serif;
}

QSpinBox:focus {
    border-color: #007aff;
}

QSpinBox::up-button, QSpinBox::down-button {
    background-color: #ffffff;
    border: 1px solid #e5e5ea;
    border-radius: 6px;
}

QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background-color: #f2f2f7;
}

/* ============================================================
   CHECK BOX
   ============================================================ */

QCheckBox {
    color: #1c1c1e;
    font-family: "SF Pro Display", -apple-system, sans-serif;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #8e8e93;
    border-radius: 4px;
    background-color: #ffffff;
}

QCheckBox::indicator:checked {
    background-color: #007aff;
    border-color: #007aff;
}

QCheckBox::indicator:hover {
    border-color: #007aff;
}

/* ============================================================
   RADIO BUTTON
   ============================================================ */

QRadioButton {
    color: #1c1c1e;
    font-family: "SF Pro Display", -apple-system, sans-serif;
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #8e8e93;
    border-radius: 9px;
    background-color: #ffffff;
}

QRadioButton::indicator:checked {
    background-color: #007aff;
    border-color: #007aff;
}

/* ============================================================
   TEXT EDIT
   ============================================================ */

QTextEdit {
    background-color: #ffffff;
    color: #1c1c1e;
    border: 1px solid #e5e5ea;
    border-radius: 10px;
    padding: 8px;
    font-family: "SF Pro Display", -apple-system, sans-serif;
    font-size: 12px;
}

QTextEdit:focus {
    border-color: #007aff;
}

/* ============================================================
   SCROLL BAR
   ============================================================ */

QScrollBar:vertical {
    background-color: #f2f2f7;
    width: 8px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background-color: #c7c7cc;
    border-radius: 4px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: #b3b3b3;
}

QScrollBar:horizontal {
    background-color: #f2f2f7;
    height: 8px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background-color: #c7c7cc;
    border-radius: 4px;
    min-width: 20px;
}

/* ============================================================
   MESSAGE BOX
   ============================================================ */

QMessageBox {
    background-color: #ffffff;
    color: #1c1c1e;
}

QMessageBox QPushButton {
    background-color: #007aff;
    color: #ffffff;
    border: none;
    border-radius: 10px;
    padding: 8px 16px;
    font-weight: 600;
    font-family: "SF Pro Display", -apple-system, sans-serif;
}

QMessageBox QPushButton:hover {
    background-color: #0066d9;
}

QMessageBox QLabel {
    color: #1c1c1e;
    font-family: "SF Pro Display", -apple-system, sans-serif;
}

/* ============================================================
   SPLITTER
   ============================================================ */

QSplitter::handle {
    background-color: #e5e5ea;
    width: 2px;
}

/* ============================================================
   SCROLL AREA
   ============================================================ */

QScrollArea {
    background-color: transparent;
    border: none;
}

/* ============================================================
   INPUT DIALOG
   ============================================================ */

QDialog {
    background-color: #ffffff;
    color: #1c1c1e;
}

QDialog QLabel {
    color: #1c1c1e;
}

QDialog QLineEdit {
    background-color: #ffffff;
    color: #1c1c1e;
    border: 1px solid #e5e5ea;
    border-radius: 10px;
    padding: 8px 12px;
}

QDialog QLineEdit:focus {
    border-color: #007aff;
}

QDialog QPushButton {
    background-color: #007aff;
    color: #ffffff;
    border: none;
    border-radius: 10px;
    padding: 8px 16px;
}

QDialog QPushButton:hover {
    background-color: #0066d9;
}

QDialog QComboBox {
    background-color: #ffffff;
    color: #1c1c1e;
    border: 1px solid #e5e5ea;
    border-radius: 10px;
    padding: 6px 12px;
}

QDialog QComboBox:hover {
    border-color: #007aff;
}

QDialog QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #1c1c1e;
    border: 1px solid #e5e5ea;
    selection-background-color: #007aff;
    selection-color: #ffffff;
}

QDialog QTextEdit {
    background-color: #ffffff;
    color: #1c1c1e;
    border: 1px solid #e5e5ea;
    border-radius: 10px;
    padding: 8px;
}

QDialog QCheckBox {
    color: #1c1c1e;
}

QDialog QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #8e8e93;
    border-radius: 4px;
    background-color: #ffffff;
}

QDialog QCheckBox::indicator:checked {
    background-color: #007aff;
    border-color: #007aff;
}